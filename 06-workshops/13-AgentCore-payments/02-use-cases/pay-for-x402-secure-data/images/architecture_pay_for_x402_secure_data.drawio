        </mxCell>
        <mxCell id="subtitle" value="Trust-gated payment flow: score endpoint first, block risky targets before paying, then retrieve paid data from a registered x402 service." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1">
