AWS_REGION=us-west-2
AWS_PROFILE=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Optional AgentCore Payments endpoint overrides.
# Leave commented to derive endpoints from AWS_REGION. The AgentCore Payments APIs are a
# private-beta botocore service model installed into ~/.aws/models (see setup/README.md),
# not a public SDK feature.
# CP_ENDPOINT=https://bedrock-agentcore-control.us-west-2.amazonaws.com
# DP_ENDPOINT=https://bedrock-agentcore.us-west-2.amazonaws.com
# CREDENTIAL_PROVIDER_ENDPOINT=https://bedrock-agentcore-control.us-west-2.amazonaws.com
# PAYMENTS_CP_ENDPOINT=https://bedrock-agentcore-control.us-west-2.amazonaws.com
# PAYMENTS_DP_ENDPOINT=https://bedrock-agentcore.us-west-2.amazonaws.com

MANAGER_ARN=
PAYMENT_CONNECTOR_ID=
CONTROL_PLANE_ROLE_ARN=
MANAGEMENT_ROLE_ARN=
PROCESS_PAYMENT_ROLE_ARN=
RESOURCE_RETRIEVAL_ROLE_ARN=
PAYMENT_SESSION_ID=
PAYMENT_INSTRUMENT_ID=
WALLET_ADDRESS=
USER_ID=test-user-x402-secure-data

# Embedded-wallet instrument + session settings (setup/setup_instrument.py).
# INSTRUMENT_EMAIL is the end-user identity the embedded wallet links to. It MUST be a REAL
# address you can receive email at: the per-wallet delegated-signing grant is completed by
# signing in to the Coinbase WalletHub with a one-time code sent here. A placeholder like
# <user>@example.com (reserved, non-deliverable) makes the grant impossible.
# Delegated signing has two one-time layers, both required: (1) the PROJECT policy at CDP
# Portal -> Wallets -> Non-custodial Wallet -> Security -> "Delegated signing" (needs your
# account 2FA), and (2) this PER-WALLET grant via WalletHub. After both, the agent signs each
# x402 payment autonomously within the session budget.
INSTRUMENT_EMAIL=
# PAYMENT_INSTRUMENT_NETWORK: "ETHEREUM" (EVM) settles USDC on **Base mainnet** for x402
# (Base Sepolia is the fallback network); "SOLANA" settles on Solana. Fund the wallet on the SETTLEMENT chain
# (e.g. Base), not Ethereum L1.
PAYMENT_INSTRUMENT_NETWORK=ETHEREUM
PAYMENT_SESSION_MAX_SPEND_USD=1.0
PAYMENT_SESSION_EXPIRY_MINUTES=60

X402_SECURE_BASE_URL=https://x402-secure-api.t54.ai
X402_SECURE_SCORE_ENDPOINT=/x402/tools/get_overall_score
X402_TRUST_THRESHOLD=50
X402_TRUST_CACHE_TTL_SECONDS=300
X402_TRUST_FAIL_CLOSED=1
HEURIST_YAHOO_FINANCE_BASE_URL=https://mesh.heurist.xyz/x402/agents/YahooFinanceAgent

TRUSTED_SETUP_PRINCIPAL_ARN=
CREDENTIAL_PROVIDER_SECRET_ARN=

COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=
COINBASE_WALLET_SECRET=

# Integration prerequisite gates require an explicit dedicated payee and small sample amount.
PAY_TO=
SESSION_MAX_SPEND=1.0
PAYMENT_AMOUNT=
MAX_PAYMENT_AMOUNT_USDC=0.25

# Safety gate for live AWS/x402 prerequisite checks.
RUN_AWS_X402_E2E=0
CONFIRM_AWS_ACCOUNT_ID=
