{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeThroughInferenceProfile",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:us-east-1:000000000000:application-inference-profile/*",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-sonnet-4-5-*"
      ]
    },
    {
      "Sid": "ResolveInferenceProfileArn",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:000000000000:parameter/multi-tenant-travel/model/*"
    }
  ]
}
