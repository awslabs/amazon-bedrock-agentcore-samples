# Identity provider for this tutorial run: "cognito" (default) or "okta".
# Set once here; notebook 01 validates it and mirrors it to SSM
# (/app/lakehouse-agent/idp-provider) for all downstream notebooks.
IDP_PROVIDER=cognito

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
