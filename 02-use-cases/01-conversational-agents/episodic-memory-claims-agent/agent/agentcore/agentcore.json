{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "ClaimsAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ClaimsAgent"
  },
  "runtimes": [
    {
      "name": "ClaimsAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "src/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "__COGNITO_DISCOVERY_URL__",
          "allowedClients": ["__COGNITO_CLIENT_ID__"]
        }
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}