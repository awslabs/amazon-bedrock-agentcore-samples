# ----------------------------------------------------------------------------
# IT Incident Response Agent - configuration
# Copy to .env and fill in. .env is gitignored.
# ----------------------------------------------------------------------------

# Stack name (used as the prefix for all created resources)
STACK_NAME=ItIncidentResponseAgent

# AWS region. Pick a region that supports Bedrock AgentCore + Bedrock KB
# (us-west-2, us-east-1 are safe defaults).
AWS_REGION=us-west-2

# Bedrock foundation model ID used by the Strands agent.
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250929-v1:0

# Bedrock embedding model used by the Knowledge Base (Titan v2 = 1024 dim).
KB_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ----------------------------------------------------------------------------
# Auth0 (used for AgentCore Identity OBO and Gateway inbound JWT auth)
#
# Pre-create:
#   1. An Auth0 API (Identifier becomes AUTH0_AUDIENCE).
#   2. An Auth0 Application (Machine to Machine) authorized for that API.
#      The Client ID / Secret go below.
# ----------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-with-m2m-client-id
AUTH0_CLIENT_SECRET=replace-with-m2m-client-secret
AUTH0_AUDIENCE=https://it-incident-response/api

# ----------------------------------------------------------------------------
# Atlassian / Jira (Remote MCP server at https://mcp.atlassian.com/v1/sse)
#
# Pre-create:
#   1. Create an OAuth 2.0 (3LO) integration at developer.atlassian.com.
#      Add scopes: read:jira-work, write:jira-work, read:me. Add the
#      AgentCore callback URL after first deploy (see README).
#   2. JIRA_SITE_URL is your Atlassian Cloud site, e.g.
#      https://your-tenant.atlassian.net
#   3. JIRA_PROJECT_KEY is the project where tickets live (e.g. INC).
# ----------------------------------------------------------------------------
JIRA_OAUTH_CLIENT_ID=replace-with-atlassian-3lo-client-id
JIRA_OAUTH_CLIENT_SECRET=replace-with-atlassian-3lo-client-secret
JIRA_SITE_URL=https://your-tenant.atlassian.net
JIRA_PROJECT_KEY=INC
