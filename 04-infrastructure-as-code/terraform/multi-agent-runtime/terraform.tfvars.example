# ============================================================================
# Multi-Agent Runtime - Example Configuration
# ============================================================================
# Copy this file to terraform.tfvars and customize
# Example: cp terraform.tfvars.example terraform.tfvars

# Agent Configuration
agent1_name = "OrchestratorAgent"
agent2_name = "SpecialistAgent"
stack_name  = "agentcore-multi-agent"

# Network Configuration
network_mode = "PUBLIC" # PUBLIC or PRIVATE

# Container Configuration
ecr_repository_name = "multi-agent"
image_tag           = "latest"

# AWS Configuration
aws_region  = "us-west-2"
environment = "dev"

# Optional: Environment Variables (if needed for custom configurations)
# environment_variables = {
#   LOG_LEVEL = "INFO"
# }

# Notes:
# - Agent1 (Orchestrator): Receives user requests and delegates to Agent2
# - Agent2 (Specialist): Provides specialized data processing capabilities
# - Agent1 code in agent1-code/ directory (includes A2A invocation logic)
# - Agent2 code in agent2-code/ directory (independent specialist)
# - A2A communication: Agent1 can invoke Agent2 via call_specialist_agent tool
# - Sequential deployment: Agent2 builds first, then Agent1
# - Test with: python test_multi_agent.py
