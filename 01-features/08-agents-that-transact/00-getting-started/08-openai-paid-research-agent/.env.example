# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
PAID_RESEARCH_WEB_SEARCH_ENABLED=true

# Optional: use an OpenAI model hosted on Amazon Bedrock with the current AWS
# credential chain.
BEDROCK_OPENAI_ENABLED=false
BEDROCK_OPENAI_REGION=us-east-1
BEDROCK_OPENAI_MODEL=openai.gpt-5.5
BEDROCK_OPENAI_WEB_SEARCH_ENABLED=false

# AgentCore Payments data-plane resources
AWS_REGION=us-east-1
PAYMENT_MANAGER_ARN=
PAYMENT_INSTRUMENT_ID=
PAYMENT_SESSION_ID=
PAYMENT_USER_ID=

# Exact HTTPS merchant hosts the payment tool may call.
PAID_RESEARCH_ALLOWED_HOSTS=x402-test.genesisblock.ai,sandbox.node4all.com
PAID_RESEARCH_URL=https://x402-test.genesisblock.ai/api/market-news
X402_MAX_PAYMENT_ATTEMPTS=5
