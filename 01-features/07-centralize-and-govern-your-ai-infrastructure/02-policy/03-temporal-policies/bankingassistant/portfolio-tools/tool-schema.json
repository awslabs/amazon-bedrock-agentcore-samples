[
  {
    "name": "get_client_profile",
    "description": "Retrieve a client's risk tolerance, investment policy, account restrictions, and associated portfolio IDs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string",
          "description": "Client identifier, e.g. CLIENT-001"
        }
      },
      "required": ["client_id"]
    }
  },
  {
    "name": "load_portfolio",
    "description": "Retrieve a portfolio's current holdings, positions, and cash balance.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "portfolio_id": {
          "type": "string",
          "description": "Portfolio identifier, e.g. PORT-8821"
        }
      },
      "required": ["portfolio_id"]
    }
  },
  {
    "name": "get_market_price",
    "description": "Fetch the current market price for a security.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Ticker symbol, e.g. AAPL"
        }
      },
      "required": ["symbol"]
    }
  },
  {
    "name": "execute_trade",
    "description": "Execute a buy or sell order against a portfolio. The gateway enforces sequencing, freshness, budget cap, and approval gate policies.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "portfolio_id": {
          "type": "string",
          "description": "Portfolio to trade against"
        },
        "symbol": {
          "type": "string",
          "description": "Ticker symbol"
        },
        "action": {
          "type": "string",
          "description": "BUY or SELL"
        },
        "shares": {
          "type": "integer",
          "description": "Number of shares"
        },
        "cost": {
          "type": "number",
          "description": "Total estimated cost in USD"
        }
      },
      "required": ["portfolio_id", "symbol", "action", "shares", "cost"]
    }
  },
  {
    "name": "rebalance_portfolio",
    "description": "Adjust portfolio allocations to match target percentages. Requires prior get_client_profile and load_portfolio in the session.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "portfolio_id": {
          "type": "string"
        },
        "target_allocations": {
          "type": "array",
          "description": "List of {symbol, target_pct} objects",
          "items": {
            "type": "object",
            "properties": {
              "symbol": { "type": "string" },
              "target_pct": { "type": "number" }
            }
          }
        }
      },
      "required": ["portfolio_id", "target_allocations"]
    }
  },
  {
    "name": "approve_trade",
    "description": "Record advisor approval for a large trade. Required by the gateway before execute_trade calls above $25,000. Each approval is consumed by a single trade.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "trade_request_id": {
          "type": "string",
          "description": "Trade request identifier"
        },
        "approved_by": {
          "type": "string",
          "description": "Advisor name or ID"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["trade_request_id", "approved_by"]
    }
  },
  {
    "name": "interact_advisor",
    "description": "Record an advisor interaction to reset the 15-minute trust-decay clock. Without this, the agent loses access to write operations after 15 minutes of inactivity.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "advisor_id": {
          "type": "string",
          "description": "Advisor identifier"
        },
        "action": {
          "type": "string",
          "description": "Type of interaction, e.g. check_in, review, approve"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["advisor_id"]
    }
  }
]
